# Copy this to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_DB=medicalrag
POSTGRES_USER=medrag
POSTGRES_PASSWORD=secure_postgres_password_here

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=secure_redis_password_here

# ─── App Security ─────────────────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_32_character_string_here
CORS_ORIGINS=http://localhost:3000,http://localhost,http://frontend:3000

# ─── Admin Credentials ────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@medicalrag.com
ADMIN_PASSWORD=secure_admin_password_here

# ─── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_here

# ─── Email Setup (SMTP) ───────────────────────────────────────────────────
# If left empty, emails will be logged to the console for development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@medicalrag.com

# ─── AI Providers ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_AI_PROVIDER=auto

# Available providers: openai, gemini, ollama
EMBEDDING_PROVIDER=openai
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
