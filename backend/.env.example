# Application
APP_NAME=MedicalRAG
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://medrag:medrag_pass@postgres:5432/medicalrag
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=medical_documents

# ── AI Provider Routing ──────────────────────────────────────────────────────
# Default provider when no X-AI-Provider header is sent: ollama | gemini | auto
DEFAULT_AI_PROVIDER=auto

# OpenAI — used ONLY for embeddings (RAG retrieval)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini — cloud LLM for chat generation
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Ollama — local LLM for chat generation
# Use host.docker.internal when backend runs in Docker and Ollama runs on host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_DEFAULT_MODEL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@medicalrag.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@medicalrag.com

# Admin
ADMIN_EMAIL=admin@medicalrag.com
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
CORS_ORIGINS=http://localhost:3000,https://medicalrag.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,md

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
